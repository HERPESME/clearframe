# ClearFrame environment — copy to .env and fill in for live mode.
# Demo mode needs NONE of these: `python -m clearframe run --demo` runs offline.

# --- Mode ---------------------------------------------------------------
# "demo" replays recorded Gemini/Parallel fixtures; "live" calls real APIs.
CLEARFRAME_MODE=demo

# --- Google Cloud (live mode) ------------------------------------------
# Project with the Vertex AI API enabled; auth via
#   gcloud auth application-default login
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=us-central1

# Gemini model for the scene scan (falls back to gemini-2.5-pro on 404).
CLEARFRAME_GEMINI_MODEL=gemini-3-pro-preview

# --- Parallel (live mode) ----------------------------------------------
# API key from https://platform.parallel.ai
PARALLEL_API_KEY=pk_your_key_here

# --- Release plan -------------------------------------------------------
# Territories the film will be distributed in. Clearance is jurisdictional:
# a mural in frame is exposed in the US (17 U.S.C. 120 covers buildings only)
# but generally permitted in Germany (UrhG 59). Comma separated.
# Supported: US, GB, DE, FR, JP, IN
CLEARFRAME_TERRITORIES=US,DE,FR

# --- Guardrails ---------------------------------------------------------
# Max findings researched per run; overflow surfaces as RESEARCH INCOMPLETE.
CLEARFRAME_MAX_RESEARCH=25
